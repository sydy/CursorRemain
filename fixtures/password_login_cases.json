      "token": "user_01LOGIN%3A%3Aaaa.bbb.ccc"
    },
    {
      "name": "ignore other cookies",
      "cookies": [
        { "name": "other", "value": "x" }
      ],
      "token": ""
    }
  ],
  "autofill": {
    "email": "name@example.com",
    "password": "p@ss\"word",
    "script_contains": [
      "name@example.com",
      "p@ss\\\"word",
      "need-user",
      "one-time-code"
    ]
  }
