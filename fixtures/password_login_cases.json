{
  "login_url": "https://cursor.com/login",
  "timeout_seconds": 180,
  "sanitize_email": [
    { "input": "  Name@Example.COM ", "output": "name@example.com" },
    { "input": "not-an-email", "output": "" },
    { "input": "a@b", "output": "" },
    { "input": "", "output": "" }
  ],
  "default_label": [
    { "email": "name@example.com", "existing": "", "output": "name@example.com" },
    { "email": "name@example.com", "existing": "工作号", "output": "工作号" }
  ],
  "cookies": [
    {
      "name": "session cookie",
      "cookies": [
        { "name": "WorkosCursorSessionToken", "value": "user_01LOGIN%3A%3Aaaa.bbb.ccc" }
      ],
      "token": "user_01LOGIN%3A%3Aaaa.bbb.ccc"
    },
    {
      "name": "ignore other cookies",
      "cookies": [
        { "name": "other", "value": "x" }
      ],
      "token": ""
    }
  ],
  "autofill": {
    "email": "name@example.com",
    "password": "p@ss\"word",
    "script_contains": [
      "name@example.com",
      "p@ss\\\"word",
      "need-user",
      "one-time-code"
    ]
  },
  "parse_paste": [
    {
      "name": "email_colon_password",
      "text": "user@example.com:secret",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "email_fullwidth_colon_password",
      "text": "user@example.com：secret",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "email_dashes_password",
      "text": "user@example.com----secret",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "email_tab_password",
      "text": "user@example.com\tsecret",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "email_spaces_password",
      "text": "user@example.com   secret",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "password_keeps_colon",
      "text": "user@example.com:pass:word",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "pass:word" }
      ]
    },
    {
      "name": "labeled_same_line_no_space",
      "text": "账号：ruby306@corradyn.com密码：6V8A8xQjNDz_VYsYc8fP9V",
      "items": [
        { "kind": "credentials", "email": "ruby306@corradyn.com", "password": "6V8A8xQjNDz_VYsYc8fP9V" }
      ]
    },
    {
      "name": "labeled_same_line_halfwidth_colon",
      "text": "账号:user@example.com密码:pass:word",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "pass:word" }
      ]
    },
    {
      "name": "labeled_two_lines",
      "text": "账号：user@example.com\n密码：secret",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "labeled_two_lines_with_blank",
      "text": "账号：user@example.com\n\n密码：secret",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "alias_邮箱",
      "text": "邮箱：a@b.co密码：x",
      "items": [
        { "kind": "credentials", "email": "a@b.co", "password": "x" }
      ]
    },
    {
      "name": "alias_用户名_two_lines",
      "text": "用户名：user@example.com\n密码：secret",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "token_user_id",
      "text": "user_01ABC::eyJhbGciOiJIUzI1NiJ9.e30.sig",
      "items": [
        { "kind": "token", "token": "user_01ABC::eyJhbGciOiJIUzI1NiJ9.e30.sig" }
      ]
    },
    {
      "name": "token_cookie_line",
      "text": "WorkosCursorSessionToken=user_01ABC%3A%3Aaaa.bbb.ccc",
      "items": [
        { "kind": "token", "token": "WorkosCursorSessionToken=user_01ABC%3A%3Aaaa.bbb.ccc" }
      ]
    },
    {
      "name": "mixed_token_and_credentials",
      "text": "user_01ABC::eyJ.e30.sig\nuser@example.com:secret",
      "items": [
        { "kind": "token", "token": "user_01ABC::eyJ.e30.sig" },
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "unrecognized",
      "text": "hello world",
      "items": [
        { "kind": "error", "message": "无法识别" }
      ]
    },
    {
      "name": "blank_lines_ignored",
      "text": "\nuser@example.com:secret\n\n",
      "items": [
        { "kind": "credentials", "email": "user@example.com", "password": "secret" }
      ]
    },
    {
      "name": "email_only_labeled_error",
      "text": "账号：user@example.com",
      "items": [
        { "kind": "error", "email": "user@example.com", "message": "只有账号没有密码" }
      ]
    },
    {
      "name": "password_only_error",
      "text": "密码：secret",
      "items": [
        { "kind": "error", "message": "只有密码没有账号" }
      ]
    }
  ]
}
