{
  "login_url": "https://cursor.com/login",
  "timeout_seconds": 180,
  "sanitize_email": [
    { "input": "  Name@Example.COM ", "output": "name@example.com" },
    { "input": "not-an-email", "output": "" },
    { "input": "a@b", "output": "" },
    { "input": "", "output": "" }
  ],
  "default_label": [
    { "email": "name@example.com", "existing": "", "output": "name@example.com" },
    { "email": "name@example.com", "existing": "工作号", "output": "工作号" }
  ],
